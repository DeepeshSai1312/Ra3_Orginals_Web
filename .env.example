# Copy to .env.local and fill in. Never commit real values.

# --- Builder.io (RA3 Originals space, not Xflow's) ---
# Builder → Account settings → Space → Public API key
NEXT_PUBLIC_BUILDERIO=
NEXT_BUILDER_API=https://cdn.builder.io/api/v3/content/
# "true" on the preview deployment used by the Builder editor: shows unpublished
# content, short caches, and lets the editor fetch live stats.
NEXT_PUBLIC_PREVIEW_MODE=false
# Shared secret for Builder's publish webhook → POST /api/revalidate
# (send it as the `x-revalidate-secret` header). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Search engines ---
# "true" only on the production domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Live stats: YouTube ---
# Google Cloud → APIs & Services → YouTube Data API v3 → API key (restrict it to that API)
YOUTUBE_API_KEY=

# --- Live stats: Instagram (Graph API) ---
# Instagram professional account ID of @ra3.originals (linked to a Facebook Page)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Long-lived token with instagram_basic + pages_show_list
# (a Business Manager system-user token avoids the 60-day expiry)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v23.0
