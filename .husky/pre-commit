# Use the Node version from .nvmrc (22) when nvm is installed. Hooks run in a
# non-interactive shell, so the version picked in your terminal isn't inherited.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null
fi

yarn lint-staged
